APP_NAME="Asistencia PWA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_PRESENTATION_TIMEZONE=America/Santiago

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=asistencia
DB_USERNAME=postgres
DB_PASSWORD=
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BCRYPT_ROUNDS=12
ATTENDANCE_CLOCK_DRIFT_MINUTES=15
